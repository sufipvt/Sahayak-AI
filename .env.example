# Copy this file to .env and fill in your own values.
# Never commit the real .env file.

# Groq API key: https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here

# The Groq model that writes answers and reads profiles.
LLM_MODEL=openai/gpt-oss-120b

# Signs login tokens. Use a long random text, e.g. the output of:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=replace-with-a-long-random-text

# Re-ranker model. MiniLM is fast on a CPU.
# The slower BGE re-ranker: BAAI/bge-reranker-base
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L6-v2
